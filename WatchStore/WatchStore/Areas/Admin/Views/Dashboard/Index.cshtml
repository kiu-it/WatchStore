
@{
    ViewBag.Title = "Bảng điều khiển";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="wrapper wrapper-content">
    <div class="row">

        <div class="col-lg-3">
            <div class="widget style1 lazur-bg">
                <div class="row">
                    <div class="col-3">
                        <i class="fa fa-cart-plus fa-5x"></i>
                    </div>
                    <div class="col-9 text-right">
                        <span> Đơn hàng mới</span>
                        <h2 class="font-bold">@ViewBag.CountOrderCancel</h2>
                        <a href="@Url.Action("Index","Order")" title="Order" target="_blank" style="color: Black"><span>  Truy cập ngay</span></a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="widget style1 lazur-bg">
                <div class="row">
                    <div class="col-3">
                        <i class="fa fa-shopping-bag fa-5x"></i>
                    </div>
                    <div class="col-9 text-right">
                        <span> Đơn hàng thanh toán</span>
                        <h2 class="font-bold">@ViewBag.CountOrderSuccess</h2>
                        <a href="@Url.Action("Index","Order")" title="Order" target="_blank" style="color: Black"><span>  Truy cập ngay</span></a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="widget style1 lazur-bg">
                <div class="row">
                    <div class="col-3">
                        <i class="fa fa-id-card fa-5x"></i>
                    </div>
                    <div class="col-9 text-right">
                        <span> Liên hệ chưa trả lời</span>
                        <h2 class="font-bold">@ViewBag.CountContactDoneReply</h2>
                        <a href="@Url.Action("Index","Contact")" title="Contact" target="_blank" style="color: Black"><span>  Truy cập ngay</span></a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="widget style1 lazur-bg">
                <div class="row">
                    <div class="col-3">
                        <i class="fa fa-users fa-5x"></i>
                    </div>
                    <div class="col-9 text-right">
                        <span> Khách hàng</span>
                        <h2 class="font-bold">@ViewBag.CountUser</h2>
                        <a href="@Url.Action("Index","Users")" title="User" target="_blank" style="color: Black"><span>  Truy cập ngay</span></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nút thống kê sản phẩm bán chạy nhất -->
        <div class="col-lg-3">
            <div class="widget style1 lazur-bg">
                <div class="row">
                    <div class="col-3">
                        <i class="fa fa-line-chart fa-5x"></i>
                    </div>
                    <div class="col-9 text-right">
                        <span> Sản phẩm bán chạy</span>
                        <h2 class="font-bold"> <!-- Số lượng hoặc chỉ số khác --></h2>
                        <a href="@Url.Action("TopSellingProducts", "Product", new { count = 5 })" class="btn btn-xs btn-primary">Xem thống kê</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nút thống kê sản phẩm không bán được -->
        <div class="col-lg-3">
            <div class="widget style1 lazur-bg">
                <div class="row">
                    <div class="col-3">
                        <i class="fa fa-exclamation-circle fa-5x"></i>
                    </div>
                    <div class="col-9 text-right">
                        <span> Sản phẩm không bán được</span>
                        <h2 class="font-bold"> <!-- Số lượng hoặc chỉ số khác --></h2>
                        <a href="@Url.Action("NonSellingProducts", "Product", new { count = 5 })" class="btn btn-xs btn-primary">Xem thống kê</a>
                    </div>
                </div>
            </div>
        </div>


    </div>
    <h1>Thống kê doanh thu</h1>
    <div style="margin-bottom: 20px;">
        <label>Chọn tháng: </label>
        <select id="monthSelect">
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i" @(i == ViewBag.ThisMonth ? "selected" : "")>Tháng @i</option>
            }
        </select>

        <label>Chọn năm: </label>
        <select id="yearSelect">
            @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year; y++)
            {
                <option value="@y" @(y == ViewBag.ThisYear ? "selected" : "")>@y</option>
            }
        </select>
    </div>
    <div id="piechart" style="width:30%;float:left;height:400px;"></div>
    <div id="chart_div" style="width:70%;float:left;height:400px;"></div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://www.gstatic.com/charts/loader.js"></script>

    <script>
        // Load Google Charts
        google.charts.load('current', { packages: ['corechart', 'bar'] });

        // Hàm vẽ lại biểu đồ
        function drawCharts(data) {
            // Pie Chart
            var pieData = google.visualization.arrayToDataTable([
                ['Task', 'Tình Trạng'],
                ['Thành công', data.countSuccess],
                ['Đã hủy', data.countCancel],
                ['Đang chờ', data.countWaiting],
                ['Đang gửi', data.countSending]
            ]);

            var pieOptions = { title: `Trạng thái đơn hàng tháng ${data.month}/${data.year}` };
            var pieChart = new google.visualization.PieChart(document.getElementById('piechart'));
            pieChart.draw(pieData, pieOptions);

            // Bar Chart
            var barDataArray = [['Ngày', 'Doanh Thu']];
            for (var i = 0; i < data.dailyRevenue.length; i++) {
                barDataArray.push(['Ngày ' + (i + 1), data.dailyRevenue[i]]);
            }

            var barData = google.visualization.arrayToDataTable(barDataArray);
            var barOptions = {
                chart: { title: `Doanh thu tháng ${data.month}/${data.year}` },
                bars: 'vertical',
                legend: { position: 'none' },
                bar: { groupWidth: "100%" }
            };

            var barChart = new google.charts.Bar(document.getElementById('chart_div'));
            barChart.draw(barData, barOptions);
        }

        // Gọi AJAX lấy dữ liệu
        function loadData() {
            var month = $('#monthSelect').val();
            var year = $('#yearSelect').val();

            $.ajax({
                url: '/Admin/Dashboard/GetDashboardData',
                type: 'GET',
                data: { month: month, year: year },
                success: function (res) {
                    if (res.success) {
                        drawCharts(res);
                    } else {
                        alert("Không có dữ liệu thống kê!");
                    }
                },
                error: function () {
                    alert("Lỗi khi tải dữ liệu thống kê.");
                }
            });
        }

        // Khi trang load xong
        $(document).ready(function () {
            google.charts.setOnLoadCallback(() => loadData());
            $('#monthSelect, #yearSelect').on('change', loadData);
        });
    </script>


</div>